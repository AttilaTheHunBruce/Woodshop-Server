[Unit]
Description=Woodshop Master TCP Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dietpi
WorkingDirectory=/home/dietpi/woodshop
ExecStart=/home/dietpi/woodshop/venv/bin/python /home/dietpi/woodshop/master_server.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
